# --- Database (Neon in production; local Postgres for dev) ---
DATABASE_URL=postgres://tempo:tempo@localhost:5432/tempo

# --- Model providers (only the ones you enable are required) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Together AI (OpenAI-compatible). To run every editor on it: TEMPO_MODEL_PROVIDER=together, TEMPO_MODEL=Qwen/Qwen3.7-Plus
TOGETHER_API_KEY=
TEMPO_MODEL_PROVIDER=
TEMPO_MODEL=
# Any other OpenAI-compatible endpoint (vLLM, OpenRouter, …)
COMPAT_BASE_URL=
COMPAT_API_KEY=

# --- Security ---
# Shared secret for /api/cron/* and the GitHub Actions tick
CRON_SECRET=change-me
# Single-user login for the web app (bcrypt-free: compared with timing-safe equality)
TEMPO_ADMIN_EMAIL=kaharema@gmail.com
TEMPO_ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-32-bytes-min

# --- Pipeline ---
TEMPO_TIMEZONE=Asia/Almaty
# Hard daily spend ceiling for model calls (USD)
TEMPO_DAILY_BUDGET_USD=3

# --- Integrations (disconnected until set) ---
GOOGLE_CALENDAR_ICS_URL=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
LINKEDIN_ACCESS_TOKEN=
X_BEARER_TOKEN=

# Write-only token for external agents pushing summaries (see docs/INTEGRATIONS.md)
INGEST_TOKEN=

# Read-only token for /api/diag (counts and statuses only)
DIAG_TOKEN=

# Google sign-in for the owner (optional). Redirect URI: https://<domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
